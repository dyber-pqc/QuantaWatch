<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX (v3) installer for QuantaWatch Desktop, driven by cargo-wix.

  Deliberately minimal and self-contained: it installs a single binary into
  "Program Files\QuantaWatch Desktop", drops a Start-menu shortcut, and registers
  an uninstall entry. No bundled License.rtf / icon / UI dialogs, so the build has
  no external asset dependencies and can't fail on a missing file in CI.

  cargo-wix passes -dVersion (from Cargo.toml) and -dCargoTargetBinDir; the
  UpgradeCode below is fixed for the life of the product so upgrades replace
  in place rather than installing side-by-side.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="QuantaWatch Desktop"
      UpgradeCode="6F3A2B1C-9D4E-4F5A-8B6C-1D2E3F4A5B6C"
      Manufacturer="Dyber, Inc."
      Language="1033"
      Codepage="1252"
      Version="$(var.Version)">

    <Package Id="*"
        Keywords="Installer"
        Description="QuantaWatch Desktop - post-quantum posture management"
        Manufacturer="Dyber, Inc."
        InstallerVersion="450"
        Languages="1033"
        Compressed="yes"
        InstallScope="perMachine"
        SummaryCodepage="1252"/>

    <MajorUpgrade
        Schedule="afterInstallInitialize"
        DowngradeErrorMessage="A newer version of QuantaWatch Desktop is already installed."/>

    <MediaTemplate EmbedCab="yes"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="QuantaWatch Desktop">
          <Component Id="MainExecutable" Guid="*">
            <File Id="DesktopExe"
                  Name="quantawatch-desktop.exe"
                  Source="$(var.CargoTargetBinDir)\quantawatch-desktop.exe"
                  KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppShortcutFolder" Name="QuantaWatch"/>
      </Directory>
    </Directory>

    <DirectoryRef Id="AppShortcutFolder">
      <Component Id="ApplicationShortcut" Guid="*">
        <Shortcut Id="AppStartMenuShortcut"
                  Name="QuantaWatch Desktop"
                  Description="Post-quantum posture management (offline)"
                  Target="[INSTALLFOLDER]quantawatch-desktop.exe"
                  WorkingDirectory="INSTALLFOLDER"/>
        <RemoveFolder Id="RemoveAppShortcutFolder" On="uninstall"/>
        <RegistryValue Root="HKCU"
                       Key="Software\Dyber\QuantaWatch"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="QuantaWatch Desktop" Level="1">
      <ComponentRef Id="MainExecutable"/>
      <ComponentRef Id="ApplicationShortcut"/>
    </Feature>
  </Product>
</Wix>
