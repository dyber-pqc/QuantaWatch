# QuantaWatch Configuration
# Copy to quantawatch.yaml and customize

gateway:
  listen: "0.0.0.0:9090"
  admin_listen: "0.0.0.0:9091"

# In-path proxy resilience. The gateway is on the critical path of every LLM
# request, so these bound worst-case latency and stop a down upstream from
# taking callers with it. All fields are optional (defaults shown).
resilience:
  connect_timeout_secs: 10        # TCP connect timeout to the upstream
  request_timeout_secs: 120       # total per-request timeout
  max_retries: 2                  # retries on transport failure (connect errors only)
  retry_backoff_ms: 200           # base backoff, doubled each attempt
  retry_on_timeout: false         # retrying a timeout risks a duplicate call
  circuit_failure_threshold: 5    # consecutive failures before the circuit opens
  circuit_cooldown_secs: 30       # how long it stays open before a probe

# CBOM attestation root of trust.
#   software      - gateway identity self-signs the quote (default; no hardware RoT)
#   synthetic-tpm - demonstrates a hardware-style AK -> platform-CA certificate
#                   chain (PQC model of a TPM 2.0 / AWS Nitro quote), verifiable
#                   by `qw verify-attestation`
#   tpm2 | nitro | sev-snp | tdx - reserved for real hardware backends
#                   (fall back to software until wired)
attestation:
  provider: software

# Air-gapped mode: refuse ALL outbound network calls except the configured LLM
# provider upstreams (which in an air-gapped site are themselves internal).
# Disables alert webhooks, evidence-pack delivery, cloud connector discovery,
# and outbound integration calls (GitHub/Jira/...) — those endpoints return 503.
# Nothing is lost locally: alerts and findings are still recorded and visible,
# migration plans are still generated (GET /api/findings/{id}/plan), and the
# audit log is exported pull-based via GET /api/audit/export.
air_gapped: false

providers:
  anthropic:
    upstream: "https://api.anthropic.com"
    protocol: anthropic
    api_key_env: ANTHROPIC_API_KEY
  openai:
    upstream: "https://api.openai.com"
    protocol: openai
    api_key_env: OPENAI_API_KEY
  ollama:
    upstream: "http://localhost:11434"
    protocol: ollama

agents:
  support-bot:
    description: "Customer support agent"
    allowed_models:
      - "claude-sonnet-*"
      - "gpt-4o"
    allowed_tools:
      - web_search
      - crm_read
    blocked_tools:
      - code_execution
      - file_delete
      - email_send
    max_tokens_per_session: 100000
    max_requests_per_minute: 60

  dev-assistant:
    description: "Engineering coding assistant"
    allowed_models:
      - "claude-*"
      - "deepseek-*"
      - "ollama/*"
    allowed_tools:
      - "*"
    blocked_actions:
      - "rm -rf"
      - "DROP TABLE"
      - "DELETE FROM"

  research-agent:
    description: "Research and analysis"
    allowed_models:
      - "ollama/*"
    allowed_tools:
      - web_search
    offline: true

identity:
  session_ttl: 3600
  # The gateway's ML-DSA-65 signing identity is persisted here as a 32-byte
  # FIPS 204 seed (gateway_seed.key, 0600) so it survives restarts — the audit
  # hash chain and CBOM attestation are signed with it, so a changing identity
  # would make every earlier signature unverifiable.
  key_dir: "./keys"
  # For multiple replicas: point this at an env var (Kubernetes Secret / KMS)
  # holding the same hex-encoded 32-byte seed, so every replica derives the
  # SAME identity. Generate one with: openssl rand -hex 32
  # seed_env: QW_GATEWAY_SEED

monitor:
  blocking_threshold: high
  scan_responses: true
  prompt_injection: true
  data_exfiltration: true
  pii_detection: true

audit:
  path: "./audit"
  merkle_batch_size: 64

policy:
  default: deny

# Cryptographic Posture Management (CPM)
scanner:
  store_path: "./scans"
  # Auto-scan provider endpoints + dependency files on startup
  auto_scan_on_start: true
  tls:
    enabled: true
    timeout_secs: 10
    # Extra TLS endpoints to fingerprint (provider upstreams are scanned automatically)
    targets:
      - "github.com:443"
  dependencies:
    enabled: true
    paths:
      - "."
  certificates:
    enabled: true
  code:
    enabled: false
    paths:
      - "./src"
    exclude:
      - "vendor"

# Background scheduled re-scanning (0 disables)
schedule:
  scan_interval_secs: 3600

# External integrations for discovery and remediation.
# api_token_env names the ENV VAR holding the secret — never put secrets here.
integrations:
  - id: github-main
    integration_type: github
    api_token_env: GITHUB_TOKEN
    settings:
      org: your-org
  # - id: jira-cloud
  #   integration_type: jira
  #   base_url: "https://your-domain.atlassian.net"
  #   api_token_env: JIRA_API_TOKEN
  #   default_project: SEC
  #   settings:
  #     email: you@example.com
  # - id: linear-main
  #   integration_type: linear
  #   api_token_env: LINEAR_API_KEY
  #   settings:
  #     team_id: your-team-id

# Continuous-attestation alerting. Channels are generic webhooks or Slack
# incoming webhooks (covers Teams/PagerDuty/email-gateways via webhook too).
alerts:
  enabled: false
  posture_drop_threshold: 5.0   # fire when overall posture falls this many points
  alert_on_critical: true       # fire on high/critical findings
  cert_expiry_days: 30
  channels:
    - id: ops-slack
      channel_type: slack       # "slack" | "webhook"
      url: "https://hooks.slack.com/services/XXX/YYY/ZZZ"
      min_severity: warning     # info | warning | critical

# Authentication & RBAC for the admin API + dashboard (disabled by default).
# Generate password hashes with:  qw hash-password 'your-password'
# Generate API keys with:         qw hash-password --api-key
# Roles: viewer (read), operator (+ trigger scans/remediation), admin (+ config).
auth:
  enabled: false
  session_ttl_secs: 28800
  # Each user/key is isolated to an `org` (tenant). Data (scans, findings,
  # posture history, remediations, alerts) is partitioned per org in SQLite.
  users:
    - username: admin
      password_hash: "$argon2id$v=19$m=19456,t=2,p=1$...replace-me..."
      role: admin
      org: default
  api_keys:
    - name: ci
      key_hash: "sha3-256-hex-of-the-key"
      role: operator
      org: default

# Declared crypto assets with BUSINESS CONTEXT. Tie an endpoint to the
# application it serves and how critical that application is, so findings are
# ranked by business impact (a quantum-vulnerable cert on checkout beats a weak
# cipher on a dev sandbox) rather than by algorithm severity alone. See the
# business-prioritized work list at GET /api/risk. A finding is matched to an
# asset by exact address or same host; unmatched findings rank as "unknown".
assets:
  - id: checkout-edge
    address: "checkout.example.com:443"
    application: checkout-api
    criticality: critical            # critical | high | medium | low
    owner: payments-team
    data_classification: pci
    environment: production
  - id: dev-sandbox
    address: "sandbox.example.com:443"
    application: dev-sandbox
    criticality: low
    owner: platform-team

# Persistence: all stores are SQLite, written to <scanner.store_path>/quantawatch.db
# (no separate config needed; the store_path above controls the location).
