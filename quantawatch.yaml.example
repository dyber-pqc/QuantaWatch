# QuantaWatch Configuration
# Copy to quantawatch.yaml and customize

gateway:
  listen: "0.0.0.0:9090"
  admin_listen: "0.0.0.0:9091"

# In-path proxy resilience. The gateway is on the critical path of every LLM
# request, so these bound worst-case latency and stop a down upstream from
# taking callers with it. All fields are optional (defaults shown).
resilience:
  connect_timeout_secs: 10        # TCP connect timeout to the upstream
  request_timeout_secs: 120       # total per-request timeout
  max_retries: 2                  # retries on transport failure (connect errors only)
  retry_backoff_ms: 200           # base backoff, doubled each attempt
  retry_on_timeout: false         # retrying a timeout risks a duplicate call
  circuit_failure_threshold: 5    # consecutive failures before the circuit opens
  circuit_cooldown_secs: 30       # how long it stays open before a probe

# CBOM attestation root of trust.
#   software      - gateway identity self-signs the quote (default; no hardware RoT)
#   synthetic-tpm - demonstrates a hardware-style AK -> platform-CA certificate
#                   chain (PQC model of a TPM 2.0 / AWS Nitro quote), verifiable
#                   by `qw verify-attestation`
#   tpm2 | nitro | sev-snp | tdx - reserved for real hardware backends
#                   (fall back to software until wired)
attestation:
  provider: software

# Crypto-agility governance: the target state you're migrating TO, and by when.
# Evaluated at GET /api/governance (verdict PASS / AT-RISK / FAIL + an agility
# score); GET /api/governance?gate=1 returns HTTP 422 on FAIL so CI blocks a
# regression. A snapshot is recorded on every scan, so GET /api/governance/history
# shows whether you're converging on the target or drifting.
crypto_policy:
  name: "CNSA 2.0 migration"
  forbidden: ["3DES", "RC4", "MD5", "SHA1", "RSA-1024"]  # never acceptable -> FAIL
  deprecated: ["RSA", "ECDSA", "ECDH", "DH"]             # migrate before the deadline
  target: ["ML-DSA", "ML-KEM"]                           # the PQC target set
  deadline: "2030-01-01T00:00:00Z"                       # deprecated must be gone by then

# Air-gapped mode: refuse ALL outbound network calls except the configured LLM
# provider upstreams (which in an air-gapped site are themselves internal).
# Disables alert webhooks, evidence-pack delivery, cloud connector discovery,
# and outbound integration calls (GitHub/Jira/...) — those endpoints return 503.
# Nothing is lost locally: alerts and findings are still recorded and visible,
# migration plans are still generated (GET /api/findings/{id}/plan), and the
# audit log is exported pull-based via GET /api/audit/export.
air_gapped: false

# In-path PQC enforcement — the moat a passive/agentless scanner can't follow.
# For every agent→provider request, the gateway checks the upstream channel's
# scanned PQC posture against `require` and either FLAGS it (monitor: allow +
# an `x-quantawatch-crypto` response header) or BLOCKS it (enforce: HTTP 403
# before the request ever leaves the enclave). Decisions are audit-logged
# (crypto_policy_enforced) and counted at quantawatch_crypto_enforcement_total.
crypto_enforcement:
  enabled: false
  mode: monitor                 # "monitor" (flag) | "enforce" (block)
  require: hybrid               # minimum channel: "pqc" | "hybrid" | "classical_secure"
  exempt_providers: []          # providers accepted as-is for now, e.g. ["anthropic"]
  block_unknown: false          # enforce: block providers not yet fingerprinted

providers:
  anthropic:
    upstream: "https://api.anthropic.com"
    protocol: anthropic
    api_key_env: ANTHROPIC_API_KEY
  openai:
    upstream: "https://api.openai.com"
    protocol: openai
    api_key_env: OPENAI_API_KEY
  ollama:
    upstream: "http://localhost:11434"
    protocol: ollama

agents:
  support-bot:
    description: "Customer support agent"
    allowed_models:
      - "claude-sonnet-*"
      - "gpt-4o"
    allowed_tools:
      - web_search
      - crm_read
    blocked_tools:
      - code_execution
      - file_delete
      - email_send
    max_tokens_per_session: 100000
    max_requests_per_minute: 60

  dev-assistant:
    description: "Engineering coding assistant"
    allowed_models:
      - "claude-*"
      - "deepseek-*"
      - "ollama/*"
    allowed_tools:
      - "*"
    blocked_actions:
      - "rm -rf"
      - "DROP TABLE"
      - "DELETE FROM"

  research-agent:
    description: "Research and analysis"
    allowed_models:
      - "ollama/*"
    allowed_tools:
      - web_search
    offline: true

identity:
  session_ttl: 3600
  # The gateway's ML-DSA-65 signing identity is persisted here as a 32-byte
  # FIPS 204 seed (gateway_seed.key, 0600) so it survives restarts — the audit
  # hash chain and CBOM attestation are signed with it, so a changing identity
  # would make every earlier signature unverifiable.
  key_dir: "./keys"
  # For multiple replicas: point this at an env var (Kubernetes Secret / KMS)
  # holding the same hex-encoded 32-byte seed, so every replica derives the
  # SAME identity. Generate one with: openssl rand -hex 32
  # seed_env: QW_GATEWAY_SEED

monitor:
  blocking_threshold: high
  scan_responses: true
  prompt_injection: true
  data_exfiltration: true
  pii_detection: true
  # Stream upstream responses to the client chunk-by-chunk, scanning incrementally
  # and cutting the stream off on detection, instead of buffering the whole
  # response first. Off by default: buffering blocks a bad response before any
  # byte is sent; streaming is detect-and-cutoff (bytes already forwarded can't be
  # recalled). Turn on for lower latency / true streaming where that trade is OK.
  stream_responses: false
  # Optional trained-classifier (semantic) detector. Off by default. Requires a
  # gateway built with `--features ml` AND a model on disk; if enabled without
  # both, the gateway refuses to start rather than silently skip it. No model is
  # bundled — supply your own (safetensors weights + a JSON `{"token": id}` vocab).
  ml:
    enabled: false
    model_path: ""        # e.g. ./models/injection.safetensors
    tokenizer_path: ""    # e.g. ./models/vocab.json
    threshold: 0.5        # P(injection) at/above which text is flagged
    severity: high        # severity assigned to a positive detection
    max_chars: 4000       # truncate longer input before classifying

# PQC-signed, tamper-evident audit log. Entries live in the store (the same
# SQLite/Postgres backend as scanner.store_path), so with a shared Postgres store
# every replica writes to ONE verifiable audit trail. The log is SHARDED: each
# replica owns its own hash-chain (keyed by writer_id, below), and a periodic
# signed "checkpoint" Merkle-roots across all replicas' chain tips to give a
# global tamper-evident anchor. Verify with GET /api/audit/verify, or export a
# bundle (GET /api/audit/export?format=bundle) and check it offline with
# `qw verify <bundle> --public-key <key>`.
audit:
  path: "./audit"                 # legacy; audit now lives in the store
  merkle_batch_size: 64
  # This replica's chain id. Must be UNIQUE per replica and STABLE across its
  # restarts. Empty = QW_AUDIT_WRITER_ID env, else HOSTNAME (the pod name in
  # Kubernetes), else "node-0" (single node). Two replicas sharing a writer_id
  # would corrupt each other's chain — leave blank and rely on the hostname.
  writer_id: ""
  # How often to commit a global checkpoint across all writers' tips (seconds).
  # 0 disables periodic checkpoints (a final one is still written at shutdown).
  checkpoint_interval_secs: 300

policy:
  default: deny

# Cryptographic Posture Management (CPM)
scanner:
  # Where persisted state lives. Two backends, selected by the value:
  #   a filesystem path  -> local SQLite at <store_path>/quantawatch.db
  #                         (single node; the default, zero-setup)
  #   postgres://...      -> shared Postgres, so multiple gateway replicas read
  #     (or postgresql://)  and write ONE store. Required for horizontal scale /
  #                         HA. Example:
  #                           postgres://qw:secret@db.internal:5432/quantawatch
  #                         The schema is created automatically on first start.
  #
  # POST-QUANTUM DB LINK: the connection uses a PQC-capable TLS client (rustls +
  # aws-lc-rs, which offers the X25519MLKEM768 hybrid group by default). Point it
  # at FortressQL (github.com/dyber-pqc/FortressQL — a PQC-hardened PostgreSQL 17)
  # with sslmode=require and the key exchange itself is post-quantum, so the DB
  # link resists harvest-now-decrypt-later. Don't leave it plaintext:
  #   postgres://qw:secret@fortressql.internal:5432/quantawatch?sslmode=require
  # sslmode: require = encrypt (no CA check; works with FortressQL's PQC certs);
  #          prefer  = encrypt if the server supports it, else plaintext (default);
  #          disable = plaintext. (verify-ca/verify-full not yet supported here.)
  #
  # NOTE: pair a Postgres store with identity.seed_env (below) so every replica
  # also shares one signing identity — otherwise replicas sign with different keys.
  store_path: "./scans"
  # Auto-scan provider endpoints + dependency files on startup
  auto_scan_on_start: true
  tls:
    enabled: true
    timeout_secs: 10
    # Extra TLS endpoints to fingerprint (provider upstreams are scanned automatically)
    targets:
      - "github.com:443"
  dependencies:
    enabled: true
    paths:
      - "."
  certificates:
    enabled: true
  code:
    enabled: false
    paths:
      - "./src"
    exclude:
      - "vendor"
  # Data-at-rest posture. Declares the data stores to evaluate (no data is ever
  # read). The KEY insight vs. a plain "is it encrypted?" check: a store can use
  # AES-256 at rest and STILL be harvest-now-decrypt-later exposed if the data
  # key is wrapped by a quantum-vulnerable KEK (RSA/ECDH) — flagged as MissingPqc.
  data_at_rest:
    enabled: true
    max_key_age_days: 365          # older data-encryption keys are flagged
    stores:
      - id: prod-postgres
        kind: database
        address: "orders-db.internal:5432"
        encryption: "aes-256-gcm"
        key_wrap: "rsa-2048"       # <- AES-256 data, but RSA-wrapped key = HNDL exposed
        key_age_days: 120
        in_transit_tls: true
        environment: production
      - id: analytics-bucket
        kind: object_store
        address: "s3://acme-analytics"
        encryption: "aes-256-gcm"
        key_wrap: "ml-kem-768"     # PQC-wrapped -> clean
        in_transit_tls: true
        environment: production
      - id: legacy-backups
        kind: volume
        address: "backup-vol-07"
        encryption: "none"         # <- unencrypted at rest = critical
        in_transit_tls: false
        environment: production

# Background scheduled re-scanning (0 disables)
schedule:
  scan_interval_secs: 3600

# External integrations for discovery and remediation.
# api_token_env names the ENV VAR holding the secret — never put secrets here.
integrations:
  - id: github-main
    integration_type: github
    api_token_env: GITHUB_TOKEN
    settings:
      org: your-org
  # - id: jira-cloud
  #   integration_type: jira
  #   base_url: "https://your-domain.atlassian.net"
  #   api_token_env: JIRA_API_TOKEN
  #   default_project: SEC
  #   settings:
  #     email: you@example.com
  # - id: linear-main
  #   integration_type: linear
  #   api_token_env: LINEAR_API_KEY
  #   settings:
  #     team_id: your-team-id

# Continuous-attestation alerting. Channels are generic webhooks or Slack
# incoming webhooks (covers Teams/PagerDuty/email-gateways via webhook too).
alerts:
  enabled: false
  posture_drop_threshold: 5.0   # fire when overall posture falls this many points
  alert_on_critical: true       # fire on high/critical findings
  cert_expiry_days: 30
  channels:
    - id: ops-slack
      channel_type: slack       # "slack" | "webhook"
      url: "https://hooks.slack.com/services/XXX/YYY/ZZZ"
      min_severity: warning     # info | warning | critical

# Authentication & RBAC for the admin API + dashboard (disabled by default).
# Generate password hashes with:  qw hash-password 'your-password'
# Generate API keys with:         qw hash-password --api-key
# Roles: viewer (read), operator (+ trigger scans/remediation), admin (+ config).
auth:
  enabled: false
  session_ttl_secs: 28800          # absolute session lifetime
  # Auth hardening (SOC2 CC6.1). Failed-login lockout is stored in the shared
  # store, so it holds across ALL replicas — not just the one that saw the
  # failures. Set max_failed_logins: 0 to disable lockout.
  max_failed_logins: 5             # lock the account after N consecutive failures
  lockout_secs: 900               # ...for this long (15 min)
  min_password_length: 12          # policy enforced by `qw hash-password`
  idle_timeout_secs: 1800          # invalidate a session idle this long (0 = off)
  # Each user/key is isolated to an `org` (tenant). Data (scans, findings,
  # posture history, remediations, alerts) is partitioned per org in the store.
  # `role` is a built-in role (viewer | auditor | operator | admin) OR a custom
  # role defined under `roles:` below.
  users:
    - username: admin
      password_hash: "$argon2id$v=19$m=19456,t=2,p=1$...replace-me..."
      role: admin
      org: default
  api_keys:
    - name: ci
      key_hash: "sha3-256-hex-of-the-key"
      role: operator
      org: default
  # Fine-grained RBAC: custom roles are permission bundles for least privilege.
  # A permission is `resource:action` (action = read | write); `*` is a wildcard.
  # Built-in roles: viewer/auditor = all reads (except config); operator adds all
  # writes (except config); admin = everything. Resources include scans, findings,
  # posture, cbom, compliance, soc2, governance, slos, alerts, integrations,
  # remediation, assets, audit, sessions, report, evidence, risk. Config is
  # admin-only. See the live map at GET /api/auth/me ("permissions").
  roles:
    # A CI gate that may read posture/SLOs/governance and trigger scans — nothing else.
    ci-gate:
      - "posture:read"
      - "slos:read"
      - "governance:read"
      - "scans:read"
      - "scans:write"
    # A compliance auditor: read-only across the board incl. evidence + SOC2 report.
    compliance-auditor:
      - "*:read"

# Declared crypto assets with BUSINESS CONTEXT. Tie an endpoint to the
# application it serves and how critical that application is, so findings are
# ranked by business impact (a quantum-vulnerable cert on checkout beats a weak
# cipher on a dev sandbox) rather than by algorithm severity alone. See the
# business-prioritized work list at GET /api/risk. A finding is matched to an
# asset by exact address or same host; unmatched findings rank as "unknown".
assets:
  - id: checkout-edge
    address: "checkout.example.com:443"
    application: checkout-api
    criticality: critical            # critical | high | medium | low
    owner: payments-team
    data_classification: pci
    environment: production
  - id: dev-sandbox
    address: "sandbox.example.com:443"
    application: dev-sandbox
    criticality: low
    owner: platform-team

# Agentless, API-first discovery connectors. Unlike a network probe, these pull
# the inventory straight from a platform API — including certs that never appear
# on a scannable endpoint (e.g. TLS secrets sitting in a cluster).
#   aws / azure / gcp  -> KMS keys, ACM/Key Vault/Cloud KMS certs
#   kubernetes         -> kubernetes.io/tls secrets (classified certs) + Ingress
#                         TLS hosts (queued for the TLS scanner)
#   generic            -> a plain host list to TLS-scan (endpoints below)
connectors:
  - name: prod-cluster
    connector_type: kubernetes
    environment: production
    # API server URL; omit to auto-detect the in-cluster endpoint.
    endpoints:
      - "https://kubernetes.default.svc"
    # Bearer token: names the env var holding it. Omit to use the in-cluster
    # service-account token at /var/run/secrets/.../token.
    tags:
      - "token_env:KUBE_TOKEN"
      # TLS to the API server. A cluster uses its own CA, so trust it explicitly
      # (omit to use the in-cluster CA at /var/run/secrets/.../ca.crt):
      - "ca_cert:/etc/quantawatch/cluster-ca.crt"
      # Dev only — skip API-server certificate verification entirely:
      # - "insecure"

# Persistence: all stores are SQLite, written to <scanner.store_path>/quantawatch.db
# (no separate config needed; the store_path above controls the location).
