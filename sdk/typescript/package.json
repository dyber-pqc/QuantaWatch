{
  "name": "@quantawatch/sdk",
  "version": "0.1.3",
  "description": "QuantaWatch TypeScript SDK - AI gateway protection and audit SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "quantawatch",
    "ai",
    "gateway",
    "security",
    "audit",
    "mcp",
    "anthropic",
    "openai"
  ],
  "license": "MIT",
  "homepage": "https://github.com/dyber-pqc/QuantaWatch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyber-pqc/QuantaWatch.git"
  },
  "bugs": {
    "url": "https://github.com/dyber-pqc/QuantaWatch/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@types/node": "^20.12.0"
  }
}
